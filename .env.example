# LangSmith / LangChain tracing configuration
# Copy this file to `.env` and fill in your own values. Do NOT commit `.env`.

# Your LangSmith API key (https://smith.langchain.com)
LANGCHAIN_API_KEY=

# Enable LangSmith tracing ("true" / "false")
LANGCHAIN_TRACING_V2=

# LangSmith API endpoint
LANGCHAIN_ENDPOINT=

# LangSmith project name traces are grouped under
LANGCHAIN_PROJECT=

# Optional overrides
OLLAMA_MODEL=
OLLAMA_BASE_URL=
